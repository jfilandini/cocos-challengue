generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt           @id @default(autoincrement())
  email         String           @db.VarChar(255)
  accountNumber String           @map("accountnumber") @db.VarChar(20)
  orders        Order[]
  snapshot      AccountSnapshot?

  @@index([accountNumber], map: "idx_users_accountnumber")
  @@map("users")
}

model Instrument {
  id         BigInt       @id @default(autoincrement())
  ticker     String       @db.VarChar(10)
  name       String       @db.VarChar(255)
  type       String       @db.VarChar(10)
  orders     Order[]
  marketData MarketData[]

  @@index([ticker], map: "idx_instruments_ticker")
  @@map("instruments")
}

model Order {
  transactionId String?    @unique(map: "uq_orders_transaction") @map("transactionid") @db.VarChar(100)
  id            BigInt     @id @default(autoincrement())
  instrumentId  BigInt     @map("instrumentid")
  userId        BigInt     @map("userid")
  size          Int
  price         Decimal    @db.Decimal(18, 2)
  type          String     @db.VarChar(10)
  side          String     @db.VarChar(10)
  status        String     @db.VarChar(20)
  datetime      DateTime   @db.Timestamp(6)
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status, datetime, id], map: "idx_orders_user_status_datetime")
  @@index([instrumentId], map: "idx_orders_instrumentid")
  @@map("orders")
}

model MarketData {
  id            BigInt      @id @default(autoincrement())
  instrumentId  BigInt      @map("instrumentid")
  high          Decimal?    @db.Decimal(18, 2)
  low           Decimal?    @db.Decimal(18, 2)
  open          Decimal?    @db.Decimal(18, 2)
  close         Decimal     @db.Decimal(18, 2)
  previousClose Decimal?    @map("previousclose") @db.Decimal(18, 2)
  date          DateTime    @db.Date
  instrument    Instrument  @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([instrumentId, date(sort: Desc), id(sort: Desc)], map: "idx_marketdata_instrument_date")
  @@map("marketdata")
}



model AccountSnapshot {
  userId       BigInt   @id @map("userid")
  settledCash  Decimal  @map("settledcash") @db.Decimal(38, 2)
  reservedCash Decimal  @map("reservedcash") @db.Decimal(38, 2)
  positions    Json     @db.JsonB
  updatedAt    DateTime @default(now()) @updatedAt @map("updatedat") @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("account_snapshots")
}
