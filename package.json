{
  "name": "cocos-challenge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del challenge de Cocos",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "snapshots:rebuild": "npm run build && node --env-file-if-exists=.env scripts/rebuild-snapshots.mjs",
    "test:unit": "npm run build:test && node --test .test-dist/test/unit/*.unit.test.js",
    "test:e2e": "npm run build:test && node --env-file=.env.test.example --env-file-if-exists=.env.test --test .test-dist/test/e2e/*.e2e.test.js",
    "test": "npm run build:test && node --env-file=.env.test.example --env-file-if-exists=.env.test --test .test-dist/test/unit/*.unit.test.js .test-dist/test/e2e/*.e2e.test.js",
    "test:orders": "npm run build:test && node --env-file=.env.test.example --env-file-if-exists=.env.test --test .test-dist/test/unit/orders*.unit.test.js .test-dist/test/e2e/orders.e2e.test.js",
    "test:db:up": "docker compose -f compose.test.yaml up -d --wait db",
    "test:db:down": "docker compose -f compose.test.yaml down",
    "test:instruments": "npm run build:test && node --env-file-if-exists=.env --test .test-dist/test/e2e/instruments.e2e.test.js .test-dist/test/unit/search-instruments.unit.test.js",
    "test:portfolio": "npm run build:test && node --env-file-if-exists=.env --test .test-dist/test/unit/portfolio*.test.js .test-dist/test/e2e/portfolio.e2e.test.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "npm run db:migrate && node --env-file-if-exists=.env dist/main.js",
    "start:dev": "npm run db:migrate && node --env-file-if-exists=.env --watch dist/main.js",
    "dev": "npm run start:dev",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:baseline": "prisma migrate diff --from-config-datasource --to-schema prisma/baseline.prisma --exit-code && prisma migrate resolve --applied 0_challenge_base",
    "build:test": "node --eval \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && prisma generate && tsc -p test/tsconfig.json",
    "test:db:baseline": "node --env-file=.env.test.example --env-file-if-exists=.env.test node_modules/prisma/build/index.js migrate diff --from-config-datasource --to-schema prisma/baseline.prisma --exit-code && node --env-file=.env.test.example --env-file-if-exists=.env.test node_modules/prisma/build/index.js migrate resolve --applied 0_challenge_base",
    "test:db:migrate": "node --env-file=.env.test.example --env-file-if-exists=.env.test node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
