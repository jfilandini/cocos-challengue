{
  "name": "cocos-challenge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del challenge de Cocos",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:unit": "npm run build && node --test test/*.unit.test.mjs",
    "test:instruments": "npm run build && node --env-file-if-exists=.env --test test/*.test.mjs",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3"
  }
}
